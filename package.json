{
  "name": "vue-turnbook",
  "version": "0.5.0",
  "description": "基于 Three.js 的 Vue 3 书本翻页组件：真实纸张卷曲、双页跨页、封面封底开合、折角拖拽、纸叠与页面热区",
  "keywords": [
    "vue3",
    "three.js",
    "threejs",
    "page-turn",
    "page-flip",
    "flipbook",
    "turn.js",
    "book",
    "3d",
    "翻页"
  ],
  "license": "MIT",
  "author": "hobohuang <1536888730@qq.com>",
  "homepage": "https://github.com/hobohuang/vue-turn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobohuang/vue-turn.git"
  },
  "bugs": {
    "url": "https://github.com/hobohuang/vue-turn/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-turn.cjs",
  "module": "./dist/vue-turn.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-turn.mjs",
      "require": "./dist/vue-turn.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:lib": "vite build --mode lib && vue-tsc --build tsconfig.build.json --force",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.86.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.86.0",
    "prettier": "3.9.5",
    "three": "^0.185.1",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
