// 库声明文件构建：仅对组件入口相关源码产出 .d.ts
{
  "extends": "./tsconfig.app.json",
  "include": ["src/**/*", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/*",
    "src/main.ts",
    "src/App.vue",
    "src/router/*",
    "src/views/*"
  ],
  "compilerOptions": {
    // 库构建的 include 覆盖了父配置（不含根目录 env.d.ts），显式补 vite/client
    // 类型，源码中的 import.meta.env.DEV 才可类型检查
    "types": ["vite/client"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo"
  }
}
